from snakemake.utils import min_version
min_version("6.0")

import sys
import os

# Load config
if "--configfile" in sys.argv:
    i = sys.argv.index("--configfile")
    config_path = sys.argv[i + 1]
    configfile: config_path
else:
    config_path = "config/config.yml"
    configfile: config_path

DATA_DIR = config['DATA_DIR']
ANALYSIS_DIR = config['ANALYSIS_DIR']
PLOTS_DIR = config['PLOTS_DIR']
LOG_DIR = config['LOG_DIR']
LOG_LEVEL = config['LOG_LEVEL']

CELL_TYPES = config['CELL_TYPES']

module sencid_workflow:
    snakefile: github("maragkakislab/wf-SenCID", path="workflow/Snakefile", branch="module")
    config: config['SenCID']

use rule * from sencid_workflow as sencid_*

rule all:
    input:
        os.path.join(ANALYSIS_DIR, "counts_SenCID_results.csv")
        os.path.join(ANALYSIS_DIR, "counts.h5ad"),
        os.path.join(PLOTS_DIR, "SenCID_predictions.pdf"),
        os.path.join(PLOTS_DIR, "library_size.pdf"),
        os.path.join(PLOTS_DIR, "mito_plot.pdf"),
        os.path.join(PLOTS_DIR, "ribo_plot.pdf"),
        os.path.join(PLOTS_DIR, "hb_plot.pdf"),
        os.path.join(ANALYSIS_DIR, "classification_results.txt"),
        os.path.join(ANALYSIS_DIR, "common_features.txt"),
        os.path.join(PLOTS_DIR, "feat_select_plot.pdf")

rule assemble_anndata:
    input:
        count_files = expand(os.path.join(DATA_DIR, "3_{cell_type}_all_results_annot.txt"), cell_type=CELL_TYPES)
    output:
        anndata = os.path.join(ANALYSIS_DIR, "counts.h5ad"),
        # save as txt file for SenCID - it cannot load h5ad object created by newer versions of scanpy
        # index is Gene_name -> rows with NaNs are removed
        txt = os.path.join(ANALYSIS_DIR, "counts.txt")
    log:
        os.path.join(LOG_DIR, "assemble_anndata.log")
    conda:
        "envs/data.yaml"
    shell:
        """
        python workflow/scripts/assemble_anndata.py \
            {input.count_files} \
            --output_h5ad {output.anndata} \
            --output_txt {output.txt} \
            --log {log} \
            --log-level {LOG_LEVEL} \
            2>&1 | tee {log}
        """

rule qc_plots:
    input:
        anndata = os.path.join(ANALYSIS_DIR, "counts.h5ad"),
    output:
        library_size_plot = os.path.join(PLOTS_DIR, "library_size.pdf"),
        mito_plot = os.path.join(PLOTS_DIR, "mito_plot.pdf"),
        ribo_plot = os.path.join(PLOTS_DIR, "ribo_plot.pdf"),
        hb_plot = os.path.join(PLOTS_DIR, "hb_plot.pdf"),
    log:
        os.path.join(LOG_DIR, "qc_plots.log")
    conda:
        "envs/data.yaml"
    shell:
        """
        python workflow/scripts/qc_plots.py \
            {input.anndata} \
            --library_size_path {output.library_size_plot} \
            --mito_path {output.mito_plot} \
            --ribo_path {output.ribo_plot} \
            --hb_path {output.hb_plot} \
            --log {log} \
            --log-level {LOG_LEVEL} \
            2>&1 | tee {log}
        """

rule ml_classifier:
    input:
        anndata = os.path.join(ANALYSIS_DIR, "counts.h5ad"),
    output:
        results_csv = os.path.join(ANALYSIS_DIR, "classification_results.txt"),
        common_features_csv = os.path.join(ANALYSIS_DIR, "common_features.txt"),
        feat_select_plot = os.path.join(PLOTS_DIR, "feat_select_plot.pdf"),
    params:
        importance_threshold = 0.01
    log:
        os.path.join(LOG_DIR, "ml_classifier.log")
    conda:
        "envs/data.yaml"
    shell:
        """
        python workflow/scripts/ml_classifier.py \
            {input.anndata} \
            --results_csv {output.results_csv} \
            --common_features_csv {output.common_features_csv} \
            --feat_select_plot {output.feat_select_plot} \
            --importance_threshold {params.importance_threshold} \
            --log {log} \
            --log-level {LOG_LEVEL} \
            2>&1 | tee {log}
        """

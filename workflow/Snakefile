from snakemake.utils import min_version
min_version("6.0")

import sys
import os

# Load config
if "--configfile" in sys.argv:
    i = sys.argv.index("--configfile")
    config_path = sys.argv[i + 1]
    configfile: config_path
else:
    config_path = "config/config.yml"
    configfile: config_path

DATA_DIR = config['DATA_DIR']
ANALYSIS_DIR = config['ANALYSIS_DIR']
PLOTS_DIR = config['PLOTS_DIR']
LOG_DIR = config['LOG_DIR']
LOG_LEVEL = config['LOG_LEVEL']

COMMON_SEN_MARKERS = config['COMMON_SEN_MARKERS']

module sencid_workflow:
    snakefile: github("maragkakislab/wf-SenCID", path="workflow/Snakefile", branch="module")
    config: config['SenCID']

use rule * from sencid_workflow as sencid_*

# Processing input counts data for ML applications
include: "rules/data.smk"
include: "rules/plots.smk"
include: "rules/cls.smk"

rule all:
    input:
        # prepare input data
        expand(os.path.join(ANALYSIS_DIR, "{input_counts}.h5ad"), input_counts=["transcriptomics", "proteomics", "Matts"]),
        expand(os.path.join(ANALYSIS_DIR, "{input_counts}.for_SenCID.txt"), input_counts=["transcriptomics", "proteomics", "Matts"]),
        
        # qc plots on raw SenCat counts
        expand(os.path.join(PLOTS_DIR, "{input_counts}.library_size.pdf"), input_counts=["transcriptomics", "proteomics"]),
        expand(os.path.join(PLOTS_DIR, "{input_counts}.mito_plot.pdf"), input_counts=["transcriptomics", "proteomics"]),
        expand(os.path.join(PLOTS_DIR, "{input_counts}.ribo_plot.pdf"), input_counts=["transcriptomics", "proteomics"]),
        expand(os.path.join(PLOTS_DIR, "{input_counts}.hb_plot.pdf"), input_counts=["transcriptomics", "proteomics"]),

        # normalized data
        expand(os.path.join(ANALYSIS_DIR, "{input_counts}.normalized.h5ad"), input_counts=["Matts"]),
        
        # SenCID results
        expand(os.path.join(ANALYSIS_DIR, "{input_counts}.SenCID_results.csv"), input_counts=["transcriptomics", "proteomics", "Matts"]),
        
        # classification results
        expand(os.path.join(ANALYSIS_DIR, "{input_counts}.classification_results.csv"), input_counts=["transcriptomics", "proteomics"]),
        expand(os.path.join(ANALYSIS_DIR, "{input_counts}.tuned_classification_results.csv"), input_counts=["transcriptomics", "proteomics"]),
        expand(os.path.join(ANALYSIS_DIR, "{input_counts}_common_features.csv"), input_counts=["transcriptomics", "proteomics"]),
        expand(os.path.join(ANALYSIS_DIR, "{input_counts}_tuned_common_features.csv"), input_counts=["transcriptomics", "proteomics"]),
        expand(os.path.join(PLOTS_DIR, "{input_counts}.feat_select_plot.pdf"), input_counts=["transcriptomics", "proteomics"]),
        
        # classification with markers results
        expand(os.path.join(ANALYSIS_DIR, "{counts_type}.{markers}_results.csv"), counts_type=["transcriptomics"], markers=["transcriptomics_common_features", "transcriptomics_tuned_common_features"]),
        expand(os.path.join(ANALYSIS_DIR, "{counts_type}.{markers}_results.csv"), counts_type=["proteomics"], markers=["proteomics_common_features", "proteomics_tuned_common_features"]),

        # classification results plots
        expand(os.path.join(PLOTS_DIR, "{counts_type}.{prediction_method}_results.pdf"), counts_type=["transcriptomics", "proteomics"], prediction_method=["classification", "tuned_classification"]),
        expand(os.path.join(PLOTS_DIR, "{counts_type}.{prediction_method}_results.pdf"), counts_type=["transcriptomics", "Matts.normalized"], prediction_method=["transcriptomics_common_features", "transcriptomics_tuned_common_features"]),
        expand(os.path.join(PLOTS_DIR, "{counts_type}.{prediction_method}_results.pdf"), counts_type=["proteomics"], prediction_method=["proteomics_common_features", "proteomics_tuned_common_features"]),
        
        # plot gene markers
        expand(os.path.join(PLOTS_DIR, "{counts_file_input}_counts.{counts_file_markers}_gene_markers.pdf"), counts_file_input=["transcriptomics"], counts_file_markers=["transcriptomics"]),
        expand(os.path.join(PLOTS_DIR, "{counts_file_input}_counts.{counts_file_markers}_gene_markers.pdf"), counts_file_input=["proteomics"], counts_file_markers=["proteomics"]),
        expand(os.path.join(PLOTS_DIR, "{counts_file_input}_counts.{counts_file_markers}_gene_markers.pdf"), counts_file_input=["transcriptomics"], counts_file_markers=COMMON_SEN_MARKERS.keys()),

        # plot gene markers with ml markers
        expand(os.path.join(PLOTS_DIR, "{counts_file_input}_counts.{counts_file_markers}_gene_markers.{counts_file_ml_markers}_ml_markers.pdf"), counts_file_input=["transcriptomics"], counts_file_markers=["transcriptomics"], counts_file_ml_markers=["transcriptomics"]),   
        expand(os.path.join(PLOTS_DIR, "{counts_file_input}_counts.{counts_file_markers}_gene_markers.{counts_file_ml_markers}_ml_markers.pdf"), counts_file_input=["proteomics"], counts_file_markers=["proteomics"], counts_file_ml_markers=["proteomics"]),   
        expand(os.path.join(PLOTS_DIR, "{counts_file_input}_counts.{counts_file_markers}_gene_markers.{counts_file_ml_markers}_ml_markers.pdf"), counts_file_input=["transcriptomics"], counts_file_markers=COMMON_SEN_MARKERS.keys(), counts_file_ml_markers=["transcriptomics"]), 

        # plot ml marker
        expand(os.path.join(PLOTS_DIR, "{counts_file_input}_counts.{counts_file_ml_markers}_ml_markers.pdf"), counts_file_input=["transcriptomics"], counts_file_ml_markers=["transcriptomics"]),
        expand(os.path.join(PLOTS_DIR, "{counts_file_input}_counts.{counts_file_ml_markers}_ml_markers.pdf"), counts_file_input=["proteomics"], counts_file_ml_markers=["proteomics"]),

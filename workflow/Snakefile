from snakemake.utils import min_version
min_version("6.0")

import sys
import os

# Load config
if "--configfile" in sys.argv:
    i = sys.argv.index("--configfile")
    config_path = sys.argv[i + 1]
    configfile: config_path
else:
    config_path = "config/config.yml"
    configfile: config_path

DATA_DIR = config['DATA_DIR']
ANALYSIS_DIR = config['ANALYSIS_DIR']
PLOTS_DIR = config['PLOTS_DIR']
LOG_DIR = config['LOG_DIR']
LOG_LEVEL = config['LOG_LEVEL']

CELL_TYPES = config['CELL_TYPES']

module sencid_workflow:
    snakefile: github("maragkakislab/wf-SenCID", path="workflow/Snakefile", branch="module")
    config: config['SenCID']

use rule * from sencid_workflow as sencid_*

# Processing input counts data for ML applications
include: "rules/data.smk"
include: "rules/plots.smk"

rule all:
    input:
        # normalized data
        expand(os.path.join(ANALYSIS_DIR, "{counts_file}.normalized.h5ad"), counts_file=["SenCat", "Matts"]),
        # SenCID results
        expand(os.path.join(ANALYSIS_DIR, "{counts_file}.SenCID_results.csv"), counts_file=["SenCat", "Matts"]),
        # results plots
        expand(os.path.join(PLOTS_DIR, "{counts_file}.SenCID_results.pdf"), counts_file=["SenCat", "Matts"]),
        expand(os.path.join(PLOTS_DIR, "{counts_file}.classification_results.pdf"), counts_file=["SenCat"]),
        # qc plots on raw SenCat counts
        expand(os.path.join(PLOTS_DIR, "{counts_file}.library_size.pdf"), counts_file=["SenCat"]),
        expand(os.path.join(PLOTS_DIR, "{counts_file}.mito_plot.pdf"), counts_file=["SenCat"]),
        expand(os.path.join(PLOTS_DIR, "{counts_file}.ribo_plot.pdf"), counts_file=["SenCat"]),
        expand(os.path.join(PLOTS_DIR, "{counts_file}.hb_plot.pdf"), counts_file=["SenCat"]),
        # classification results
        expand(os.path.join(ANALYSIS_DIR, "{counts_file}.classification_results.csv"), counts_file=["SenCat"]),
        expand(os.path.join(ANALYSIS_DIR, "{counts_file}.common_features.csv"), counts_file=["SenCat"]),
        expand(os.path.join(PLOTS_DIR, "{counts_file}.feat_select_plot.pdf"), counts_file=["SenCat"])

use rule get_SenCID_predictions from sencid_workflow as sencid_get_SenCID_predictions with:
    output:
        rec = os.path.join(ANALYSIS_DIR, "{counts_file}.SenCID_results.csv")
    input: 
        txt = os.path.join(ANALYSIS_DIR, "{counts_file}.for_SenCID.txt")
    params:
        denoising = False

rule ml_classifier:
    input:
        anndata = os.path.join(ANALYSIS_DIR, "SenCat.normalized.h5ad"),
    output:
        results_csv = os.path.join(ANALYSIS_DIR, "SenCat.classification_results.csv"),
        common_features_csv = os.path.join(ANALYSIS_DIR, "SenCat.common_features.csv"),
        feat_select_plot = os.path.join(PLOTS_DIR, "SenCat.feat_select_plot.pdf"),
    params:
        importance_threshold = 0.001
    log:
        os.path.join(LOG_DIR, "ml_classifier.log")
    conda:
        "envs/data.yaml"
    shell:
        """
        python workflow/scripts/ml_classifier.py \
            {input.anndata} \
            --results_csv {output.results_csv} \
            --common_features_csv {output.common_features_csv} \
            --feat_select_plot {output.feat_select_plot} \
            --importance_threshold {params.importance_threshold} \
            --log {log} \
            --log-level {LOG_LEVEL} \
            2>&1 | tee {log}
        """

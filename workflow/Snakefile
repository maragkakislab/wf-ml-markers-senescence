wildcard_constraints:
    input_counts = "|".join(["transcriptomics", "proteomics", "Matt_transcriptomic", "Matt_transcriptomic.normalized", "Matt_proteomic", "Matt_proteomic.normalized"]),
    counts_type_markers = "|".join(["transcriptomics", "proteomics"]),
    ml_classifier = "|".join(ML_CLASSIFIER.keys()),

ruleorder: ml_classifier > marker_classifier

rule all:

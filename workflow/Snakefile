from snakemake.utils import min_version
min_version("6.0")

import sys
import os

# Load config
if "--configfile" in sys.argv:
    i = sys.argv.index("--configfile")
    config_path = sys.argv[i + 1]
    configfile: config_path
else:
    config_path = "config/config.yml"
    configfile: config_path

DATA_DIR = config['DATA_DIR']
ANALYSIS_DIR = config['ANALYSIS_DIR']
PLOTS_DIR = config['PLOTS_DIR']
LOG_DIR = config['LOG_DIR']
LOG_LEVEL = config['LOG_LEVEL']

CELL_TYPES = config['CELL_TYPES']
COMMON_SEN_MARKERS = config['COMMON_SEN_MARKERS']

module sencid_workflow:
    snakefile: github("maragkakislab/wf-SenCID", path="workflow/Snakefile", branch="module")
    config: config['SenCID']

use rule * from sencid_workflow as sencid_*

# Processing input counts data for ML applications
include: "rules/data.smk"
include: "rules/plots.smk"
include: "rules/cls.smk"

rule all:
    input:
        # normalized data
        expand(os.path.join(ANALYSIS_DIR, "{counts_file}.normalized.h5ad"), counts_file=["SenCat", "Matts"]),
        # SenCID results
        expand(os.path.join(ANALYSIS_DIR, "{counts_file}.SenCID_results.csv"), counts_file=["SenCat", "Matts"]),
        # results plots
        expand(os.path.join(PLOTS_DIR, "{counts_file}.{predictio_method}_results.pdf"), counts_file=["SenCat"], predictio_method=["classification", "tuned_classification"]),
        expand(os.path.join(PLOTS_DIR, "{counts_file}.{predictio_method}_results.pdf"), counts_file=["SenCat", "Matts"], predictio_method=["SenCID", "common_features", "tuned_common_features"]),
        # qc plots on raw SenCat counts
        expand(os.path.join(PLOTS_DIR, "{counts_file}.library_size.pdf"), counts_file=["SenCat", "SenCat.normalized"]),
        expand(os.path.join(PLOTS_DIR, "{counts_file}.mito_plot.pdf"), counts_file=["SenCat"]),
        expand(os.path.join(PLOTS_DIR, "{counts_file}.ribo_plot.pdf"), counts_file=["SenCat"]),
        expand(os.path.join(PLOTS_DIR, "{counts_file}.hb_plot.pdf"), counts_file=["SenCat"]),
        # classification results
        expand(os.path.join(ANALYSIS_DIR, "{counts_file}.classification_results.csv"), counts_file=["SenCat"]),
        expand(os.path.join(ANALYSIS_DIR, "{counts_file}.common_features.csv"), counts_file=["SenCat"]),
        expand(os.path.join(PLOTS_DIR, "{counts_file}.feat_select_plot.pdf"), counts_file=["SenCat"]),
        # classification with markers results
        expand(os.path.join(ANALYSIS_DIR, "{counts_file}.{markers}_results.csv"), counts_file=["SenCat", "Matts"], markers=["common_features", "tuned_common_features"]),
        # prepare common sen markers
        expand(os.path.join(ANALYSIS_DIR, "{sen_markers}.common_features.csv"), sen_markers=COMMON_SEN_MARKERS.keys()),
        # plot gene markers
        expand(os.path.join(PLOTS_DIR, "{counts_file_input}_counts.{counts_file_markers}_gene_markers.pdf"), counts_file_input=["SenCat"], counts_file_markers=["SenCat"]),
        expand(os.path.join(PLOTS_DIR, "{counts_file_input}_counts.{counts_file_markers}_gene_markers.pdf"), counts_file_input=["SenCat"], counts_file_markers=COMMON_SEN_MARKERS.keys()),
        # plot gene markers with ml markers
        expand(os.path.join(PLOTS_DIR, "{counts_file_input}_counts.{counts_file_markers}_gene_markers.{counts_file_ml_markers}_ml_markers.pdf"), counts_file_input=["SenCat"], counts_file_markers=["SenCat"], counts_file_ml_markers=["SenCat"]),   
        expand(os.path.join(PLOTS_DIR, "{counts_file_input}_counts.{counts_file_markers}_gene_markers.{counts_file_ml_markers}_ml_markers.pdf"), counts_file_input=["SenCat"], counts_file_markers=COMMON_SEN_MARKERS.keys(), counts_file_ml_markers=["SenCat"]),   
        # plot ml marker
        expand(os.path.join(PLOTS_DIR, "{counts_file_input}_counts.{counts_file_ml_markers}_ml_markers.pdf"), counts_file_input=["SenCat"], counts_file_ml_markers=["SenCat"]),
